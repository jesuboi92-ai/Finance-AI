# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logistics_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=logistics_saas
DB_HOST=localhost
DB_PORT=5432

# Application
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# Azure
AZURE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=logistics-files
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# SendGrid Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@logistics-saas.com

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_MICROSOFT_CLIENT_ID=
OAUTH2_MICROSOFT_CLIENT_SECRET=
